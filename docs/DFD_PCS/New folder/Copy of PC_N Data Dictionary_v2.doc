        <tr><td>PC-N-14.2</td><td>Numeric Rank Field</td><td>InputField (Number)</td><td>Rank value (e.g. 1, 2, 3).</td><td>42</td><td>Manual Entry</td><td class="data-flow">Sustained</td></tr>
