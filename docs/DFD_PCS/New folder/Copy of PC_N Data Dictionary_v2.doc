        <tr><td>PC-N-11.5</td><td>Others</td><td>InputField (Number)</td><td>Miscellaneous operating costs.</td><td>42</td><td>Manual Entry</td><td class="data-flow">Sustained</td></tr>
    </tbody>
</table>

