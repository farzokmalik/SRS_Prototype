<html>
<head>
<meta charset="utf-8">
<style>
    body { font-family: Calibri, sans-serif; font-size: 11pt; line-height: 1.5; }
    h1 { color: #2F5496; border-bottom: 2px solid #2F5496; margin-bottom: 10px; }
    h2 { color: #1F3763; margin-top: 25px; margin-bottom: 10px; border-bottom: 1px solid #BDD7EE; padding-bottom: 5px; }
    table { border-collapse: collapse; width: 100%; margin-bottom: 20px; table-layout: fixed; word-wrap: break-word; }
    th, td { border: 1px solid #8497B0; padding: 8px; text-align: left; vertical-align: top; }
    th { background-color: #D9EAD3; font-weight: bold; color: #375623; }
    .sr-no { width: 80px; }
    .data-flow { background-color: #FFF2CC; font-weight: bold; width: 100px; }
</style>
</head>
<body>
<h1>PC - N Data Dictionary</h1>

<h2>Section 1 — Project Title</h2>
<table>
    <thead>
        <tr>
            <th class="sr-no">Sr. No.</th>
            <th>Information Required</th>
            <th>Input Component</th>
            <th>Expected Data / Business Rules</th>
            <th>Example</th>
            <th>Cross Reference</th>
            <th class="data-flow">Data Flow</th>
        </tr>
    </thead>
    <tbody>
        <tr><td>PC-N-1.1</td><td>Full Project Title</td><td>InputField</td><td>Complete name/title of the proposed project.</td><td>Punjab Solar Energy Optimization Project</td><td>Manual Entry</td><td class="data-flow">DF-1, DF-2</td></tr>
        <tr><td>PC-N-1.2</td><td>Project ID</td><td>InputField</td><td>Unique ProjectID</td><td>PRJ-2024-0010</td><td>Manual Entry</td><td class="data-flow">DF-1, DF-2</td></tr>
    </tbody>
</table>

<h2>Section 2 — Context & Nutrients</h2>
<table>
    <thead>
        <tr>
            <th class="sr-no">Sr. No.</th>
            <th>Information Required</th>
            <th>Input Component</th>
            <th>Expected Data / Business Rules</th>
            <th>Example</th>
            <th>Cross Reference</th>
            <th class="data-flow">Data Flow</th>
        </tr>
    </thead>
    <tbody>
        <tr><td>PC-N-2.1</td><td>Background & Rationale</td><td>TextArea</td><td>Strategic context and justification.</td><td>This project will solve energy scarcity in 5 remote villages through 10MW solar fields.</td><td>Manual Entry</td><td class="data-flow">DF-1, DF-2</td></tr>
        <tr><td>PC-N-2.2</td><td>Specific Crop Health Benefits</td><td>TextArea</td><td>Impact on agricultural productivity.</td><td>General narrative text entry</td><td>Manual Entry</td><td class="data-flow">Sustained</td></tr>
        <tr><td>PC-N-2.3</td><td>Technical Diagrams / Figures</td><td>FileUpload</td><td>Proponent charts or geographical figures.</td><td>project_scope.pdf</td><td>Manual Entry</td><td class="data-flow">Sustained</td></tr>
        <tr><td>PC-N-2.4</td><td>Nutrient / Parameter</td><td>InputField</td><td>e.g. Protein Content.</td><td>Domain specific input</td><td>Manual Entry</td><td class="data-flow">Sustained</td></tr>
        <tr><td>PC-N-2.5</td><td>Parameter Value</td><td>InputField (Number)</td><td>Measured value (e.g. 18.5).</td><td>42</td><td>Manual Entry</td><td class="data-flow">Sustained</td></tr>
        <tr><td>PC-N-2.6</td><td>Parameter Unit</td><td>InputField</td><td>measurement unit (e.g. %).</td><td>Domain specific input</td><td>Manual Entry</td><td class="data-flow">Sustained</td></tr>
    </tbody>
</table>

<h2>Section 3 — Goals & Objectives</h2>
<table>
    <thead>
        <tr>
            <th class="sr-no">Sr. No.</th>
            <th>Information Required</th>
            <th>Input Component</th>
            <th>Expected Data / Business Rules</th>
            <th>Example</th>
            <th>Cross Reference</th>
            <th class="data-flow">Data Flow</th>
        </tr>
    </thead>
    <tbody>
        <tr><td>PC-N-3.1</td><td>Objectives Statement</td><td>TextArea (Large)</td><td>Primary and secondary goals of the project.</td><td>This project will solve energy scarcity in 5 remote villages through 10MW solar fields.</td><td>Manual Entry</td><td class="data-flow">DF-1, DF-2</td></tr>
    </tbody>
</table>

<h2>Section 4 — Funding Rationale</h2>
<table>
    <thead>
        <tr>
            <th class="sr-no">Sr. No.</th>
            <th>Information Required</th>
            <th>Input Component</th>
            <th>Expected Data / Business Rules</th>
            <th>Example</th>
            <th>Cross Reference</th>
            <th class="data-flow">Data Flow</th>
        </tr>
    </thead>
    <tbody>
        <tr><td>PC-N-4.1</td><td>Qualifies for ADP Funding?</td><td>RadioGroup</td><td>Yes / No.</td><td>Yes</td><td>Manual Entry</td><td class="data-flow">Sustained</td></tr>
        <tr><td>PC-N-4.2</td><td>Justification for ADP</td><td>TextArea</td><td>(Required if Yes) Explain priority for ADP.</td><td>This project will solve energy scarcity in 5 remote villages through 10MW solar fields.</td><td>Manual Entry</td><td class="data-flow">Sustained</td></tr>
    </tbody>
</table>

<h2>Section 5 — Geographical Coverage</h2>
<table>
    <thead>
        <tr>
            <th class="sr-no">Sr. No.</th>
            <th>Information Required</th>
            <th>Input Component</th>
            <th>Expected Data / Business Rules</th>
            <th>Example</th>
            <th>Cross Reference</th>
            <th class="data-flow">Data Flow</th>
        </tr>
    </thead>
    <tbody>
        <tr><td>PC-N-5.1</td><td>Coverage Selection</td><td>RadioGroup</td><td>Whole Province / Specific Districts.</td><td>Yes</td><td>Manual Entry</td><td class="data-flow">DF-1, DF-2</td></tr>
        <tr><td>PC-N-5.2</td><td>Selected Districts</td><td>MultiCheckGroup</td><td>List of districts (e.g., Multan, Vehari).</td><td>Kasur</td><td>Manual Entry</td><td class="data-flow">DF-1, DF-2</td></tr>
    </tbody>
</table>

