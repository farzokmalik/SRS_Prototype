    </thead>
    <tbody>
        <tr><td>PC-N-9.1</td><td>Gestation Period Start Date</td><td>InputField Date</td><td>Date (MM-DD-YYYY)</td><td>01-Jul-2024</td><td>Manual Entry</td><td class="data-flow">DF-1, DF-2</td></tr>
        <tr><td>PC-N-9.2</td><td>Gestation Period End Date</td><td>InputField Date</td><td>Date (MM-DD-YYYY)</td><td>30-Jun-2026</td><td>Manual Entry</td><td class="data-flow">DF-1, DF-2</td></tr>
    </tbody>
</table>

