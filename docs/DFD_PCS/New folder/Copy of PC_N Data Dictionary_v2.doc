            <th class="data-flow">Data Flow</th>
        </tr>
    </thead>
    <tbody>
        <tr><td>PC-N-10.1</td><td>Phasing Year</td><td>SelectField</td><td>e.g. 2024-25.</td><td>2024-2025</td><td>Manual Entry</td><td class="data-flow">DF-1, DF-2</td></tr>
        <tr><td>PC-N-10.2</td><td>Local Amount</td><td>InputField (Number)</td><td>PKR Million.</td><td>5000</td><td>Manual Entry</td><td class="data-flow">DF-1, DF-2</td></tr>
        <tr><td>PC-N-10.3</td><td>Foreign Amount</td><td>InputField (Number)</td><td>Foreign component amount.</td><td>5000</td><td>Manual Entry</td><td class="data-flow">DF-1, DF-2</td></tr>
        <tr><td>PC-N-10.4</td><td>Total Amount</td><td>InputField (Number)</td><td>Total for the year.</td><td>5000</td><td>Manual Entry</td><td class="data-flow">DF-1, DF-2</td></tr>
    </tbody>
</table>

