            <th>Cross Reference</th>
            <th class="data-flow">Data Flow</th>
        </tr>
    </thead>
    <tbody>
        <tr><td>PC-N-6.1</td><td>Sector Plan Alignment</td><td>TextArea</td><td>Relationship with provincial strategies.</td><td>Renewable Energy</td><td>Manual Entry</td><td class="data-flow">Sustained</td></tr>
    </tbody>
</table>

<h2>Section 7 — SDG & Growth Pillars</h2>
<table>
    <thead>
        <tr>
            <th class="sr-no">Sr. No.</th>
            <th>Information Required</th>
            <th>Input Component</th>
            <th>Expected Data / Business Rules</th>
            <th>Example</th>
            <th>Cross Reference</th>
            <th class="data-flow">Data Flow</th>
        </tr>
    </thead>
    <tbody>
        <tr><td>PC-N-7.1</td><td>Primary SDG Goal Alignment</td><td>SelectField</td><td>Selection from 17 SDG Goals.</td><td>Selected Valid Option</td><td>Manual Entry</td><td class="data-flow">Sustained</td></tr>
        <tr><td>PC-N-7.2</td><td>Compliance Explanation</td><td>TextArea</td><td>Alignment with SDG targets/indicators.</td><td>General narrative text entry</td><td>Manual Entry</td><td class="data-flow">Sustained</td></tr>
        <tr><td>PC-N-7.3</td><td>Growth Pillars Alignment</td><td>MultiCheckGroup</td><td>Alignment with Pillars (e.g. Digital Trans.).</td><td>Domain specific input</td><td>Manual Entry</td><td class="data-flow">Sustained</td></tr>
        <tr><td>PC-N-7.4</td><td>Pillars Justification</td><td>TextArea</td><td>Detailed reasoning for pillars selection.</td><td>This project will solve energy scarcity in 5 remote villages through 10MW solar fields.</td><td>Manual Entry</td><td class="data-flow">Sustained</td></tr>
    </tbody>
</table>

<h2>Section 8 — Nearest Similar Facility</h2>
<table>
    <thead>
        <tr>
            <th class="sr-no">Sr. No.</th>
            <th>Information Required</th>
            <th>Input Component</th>
            <th>Expected Data / Business Rules</th>
            <th>Example</th>
            <th>Cross Reference</th>
            <th class="data-flow">Data Flow</th>
        </tr>
    </thead>
    <tbody>
        <tr><td>PC-N-8.1</td><td>Nearest similar facility?</td><td>RadioGroup</td><td>Yes / No.</td><td>Yes</td><td>Manual Entry</td><td class="data-flow">Sustained</td></tr>
        <tr><td>PC-N-8.2</td><td>Facility Title</td><td>InputField</td><td>If 8.1 is yes</td><td>Domain-specific input</td><td>Manual Entry</td><td class="data-flow">Sustained</td></tr>
        <tr><td>PC-N-8.3</td><td>Facility Location</td><td>InputField</td><td>If 8.1 is yes</td><td>Domain-specific input</td><td>Manual Entry</td><td class="data-flow">Sustained</td></tr>
    </tbody>
</table>

