<html>
<head>
<meta charset="utf-8">
<style>
    body { font-family: Calibri, sans-serif; font-size: 10pt; line-height: 1.3; }
    h1 { color: #2F5496; border-bottom: 2px solid #2F5496; margin-bottom: 10px; text-align: center; }
    h2 { color: #1F3763; margin-top: 20px; margin-bottom: 8px; border-bottom: 1px solid #BDD7EE; padding-bottom: 3px; font-size: 14pt; }
    h3 { color: #2E75B5; margin-top: 15px; margin-bottom: 5px; font-size: 12pt; }
    table { border-collapse: collapse; width: 100%; margin-bottom: 15px; table-layout: fixed; word-wrap: break-word; }
    th, td { border: 1px solid #8497B0; padding: 5px; text-align: left; vertical-align: top; }
    th { background-color: #DDEBF7; font-weight: bold; color: #1F3763; font-size: 9pt; }
    .sr-no { width: 60px; }
    .data-flow { background-color: #FFF2CC; font-weight: bold; width: 70px; text-align: center; }
    .scenario { background-color: #F2F2F2; font-size: 8pt; }
</style>
</head>
<body>
<h1>PC - I Data Dictionary</h1>

<h2>Section 1 — General Information / Overview</h2>
<h3>Project Core Details</h3>
<table>
    <thead>
        <tr>
            <th class="sr-no">Sr. No.</th>
            <th>Information Required</th>
            <th>Input Component</th>
            <th>Expected Data / Business Rules</th>
            <th>Example</th>
            <th class="scenario">Scenario A (PC-II filled)</th>
            <th class="scenario">Scenario B (PC-II skipped)</th>
            <th class="data-flow">Data Flow</th>
        </tr>
    </thead>
    <tbody>
        <tr><td>PC-I-1.1</td><td>Project Title</td><td>Text Input</td><td>Full formal name of the project</td><td>Punjab Solar Energy Optimization Project</td><td>PC-II-1.1 (← PC-N-1.1)</td><td>PC-N-1.1</td><td class="data-flow">DF-4</td></tr>
        <tr><td>PC-I-1.2</td><td>Project ID</td><td>SelectField</td><td>Select Unique ProjectID</td><td>PRJ-2024-0010</td><td>PC-II-1.2 (← PC-N-1.2)</td><td>PC-N-1.2</td><td class="data-flow">DF-4</td></tr>
        <tr><td>PC-I-1.3</td><td>Meta Tags</td><td>Text Input</td><td>Search keywords (e.g., Infrastructure, Health)</td><td>Solar Energy, Punjab</td><td>PC-II-1.3</td><td>Manual Entry</td><td class="data-flow">Sustained</td></tr>
        <tr><td>PC-I-1.4</td><td>Project Start Year</td><td>SelectField</td><td>Financial year (e.g., '2023-2024')</td><td>2024-2025</td><td>PC-II-1.4 (← PC-N-10.1)</td><td>PC-N-10.1</td><td class="data-flow">DF-4</td></tr>
        <tr><td>PC-I-1.5</td><td>Start Date</td><td>Date Picker</td><td>Specific calendar date</td><td>01-Jul-2024</td><td>PC-II-1.5 (← PC-N-9.1)</td><td>PC-N-9.1</td><td class="data-flow">DF-4</td></tr>
        <tr><td>PC-I-1.6</td><td>End Date</td><td>Date Picker</td><td>Specific calendar date</td><td>30-Jun-2026</td><td>PC-II-1.6 (← PC-N-9.2)</td><td>PC-N-9.2</td><td class="data-flow">DF-4</td></tr>
        <tr><td>PC-I-1.7</td><td>GS No.</td><td>Text Input</td><td>Official GS designation (e.g., GS-2024-X10)</td><td>GS-24-X999</td><td>PC-II-1.7</td><td>Manual Entry</td><td class="data-flow">DF-4</td></tr>
        <tr><td>PC-I-1.8</td><td>Administrative Department</td><td>SelectField</td><td>'School Education Department', 'Health Department', etc.</td><td>Energy Department</td><td>PC-II-1.8</td><td>Manual Entry</td><td class="data-flow">DF-4</td></tr>
        <tr><td>PC-I-1.9</td><td>Main Sector</td><td>SelectField</td><td>Broad category ('Social Sectors', 'Infrastructure', etc.)</td><td>Renewable Energy</td><td>PC-II-1.9</td><td>Manual Entry</td><td class="data-flow">DF-4</td></tr>
        <tr><td>PC-I-1.10</td><td>Sector</td><td>SelectField</td><td>Sub-category dependent on Main Sector</td><td>Renewable Energy</td><td>PC-II-1.10</td><td>Manual Entry</td><td class="data-flow">DF-4</td></tr>
        <tr><td>PC-I-1.11</td><td>Location Type</td><td>Radio Buttons</td><td>'Rural', 'Urban', or 'Both'</td><td>Rural</td><td>PC-II-1.11</td><td>Manual Entry</td><td class="data-flow">Sustained</td></tr>
        <tr><td>PC-I-1.12</td><td>Project Status</td><td>SelectField</td><td>'Approved', 'Unapproved', or 'Dropped'</td><td>Approved</td><td>PC-II-1.12</td><td>Manual Entry</td><td class="data-flow">DF-4</td></tr>
        <tr><td>PC-I-1.13</td><td>Project Status Type</td><td>Multi-Checkbox</td><td>Multiple select ('Flagship', 'PPP', 'PM Package', etc.)</td><td>Flagship</td><td>PC-II-1.13</td><td>Manual Entry</td><td class="data-flow">Sustained</td></tr>
        <tr><td>PC-I-1.13</td><td>Foreign Funding</td><td>Radio Buttons</td><td>'Yes' or 'No'</td><td>Yes</td><td>PC-II-1.14</td><td>Manual Entry</td><td class="data-flow">DF-4</td></tr>
        <tr><td>PC-I-1.14</td><td>Foreign Exchange Component (FEC)</td><td>InputField (Number)</td><td>Required if Foreign Funding is Yes</td><td>42</td><td>Unique to PC-I</td><td>Manual Entry</td><td class="data-flow">DF-4</td></tr>
        <tr><td>PC-I-1.15</td><td>Foreign Cost</td><td>InputField (Number)</td><td>Value in Millions</td><td>5000</td><td>PC-II-1.15 (auto-calculated)</td><td>Manual Entry</td><td class="data-flow">DF-4</td></tr>
        <tr><td>PC-I-1.21</td><td>Local Cost (PKR)</td><td>InputField (Number)</td><td>Value in Millions</td><td>5000</td><td>PC-II-1.24 + PC-II-1.25</td><td>Manual Entry</td><td class="data-flow">DF-4</td></tr>
        <tr><td>PC-I-1.23</td><td>Total Cost (PKR)</td><td>InputField (Number)</td><td>Combined final cost in Millions</td><td>5000</td><td>PC-II-1.27</td><td>Manual Entry</td><td class="data-flow">DF-4</td></tr>
    </tbody>
</table>

<h2>Section 2 — Location</h2>
<table>
    <thead>
        <tr>
            <th class="sr-no">Sr. No.</th>
            <th>Information Required</th>
            <th>Input Component</th>
            <th>Expected Data / Business Rules</th>
            <th>Example</th>
            <th class="scenario">Scenario A (PC-II filled)</th>
            <th class="scenario">Scenario B (PC-II skipped)</th>
            <th class="data-flow">Data Flow</th>
        </tr>
    </thead>
    <tbody>
        <tr><td>PC-I-2.1</td><td>Division</td><td>SelectField</td><td>All divisions of Punjab</td><td>Lahore</td><td>PC-II-2.1</td><td>PC-N-5.1 / PC-N-5.2</td><td class="data-flow">DF-4</td></tr>
        <tr><td>PC-I-2.2</td><td>District</td><td>SelectField</td><td>Dependent on selected Division</td><td>Kasur</td><td>PC-II-2.2</td><td>PC-N-5.2</td><td class="data-flow">DF-4</td></tr>
    </tbody>
</table>

<h2>Section 7 — Cost Estimates & WBS</h2>
<table>
    <thead>
        <tr>
            <th class="sr-no">Sr. No.</th>
            <th>Information Required</th>
            <th>Input Component</th>
            <th>Expected Data / Business Rules</th>
            <th>Example</th>
            <th class="scenario">Scenario A (PC-II filled)</th>
            <th class="scenario">Scenario B (PC-II skipped)</th>
            <th class="data-flow">Data Flow</th>
        </tr>
    </thead>
    <tbody>
        <tr><td>PC-I-7.12</td><td>Object Code</td><td>Searchable SelectField</td><td>Standard code (e.g., A01101)</td><td>A01101</td><td>PC-II-6.10</td><td>Manual Entry</td><td class="data-flow">DF-4</td></tr>
        <tr><td>PC-I-7.14</td><td>Local Cost Estimate</td><td>InputField (Number)</td><td>Projected amount (Millions)</td><td>5000</td><td>PC-II-6.11</td><td>Manual Entry</td><td class="data-flow">DF-4</td></tr>
    </tbody>
</table>

<h2>Section 20 — Upward Revision</h2>
<table>
    <thead>
        <tr>
            <th class="sr-no">Sr. No.</th>
            <th>Information Required</th>
            <th>Input Component</th>
            <th>Expected Data / Business Rules</th>
            <th>Example</th>
            <th class="scenario">Scenario A (PC-II filled)</th>
            <th class="scenario">Scenario B (PC-II skipped)</th>
            <th class="data-flow">Data Flow</th>
        </tr>
    </thead>
    <tbody>
        <tr><td>PC-I-20.1</td><td>Revision Status</td><td>SelectField</td><td>'Original', '1st Revised', etc.</td><td>Selected Valid Option</td><td>Unique to PC-I</td><td>Manual Entry</td><td class="data-flow">DF-9</td></tr>
        <tr><td>PC-I-20.2</td><td>Revised Cost</td><td>InputField (Number)</td><td>Final approved cost (Millions)</td><td>5000</td><td>Unique to PC-I</td><td>Manual Entry</td><td class="data-flow">DF-9</td></tr>
    </tbody>
</table>

<p><i>Note: Full dictionary details with over 300 fields are available in the source Markdown files.</i></p>
</body>
</html>
