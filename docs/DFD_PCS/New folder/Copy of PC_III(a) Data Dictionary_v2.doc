            <th>Information Required</th>
            <th>Input Component</th>
            <th>Expected Data / Business Rules</th>
            <th>Example</th>
            <th>Cross Reference</th>
            <th class="data-flow">Data Flow</th>
        </tr>
    </thead>
    <tbody>
        <tr><td>PC-III(a)-1.1</td><td>Project Name</td><td>Text Input</td><td>Full formal name of the project</td><td>Punjab Solar Energy Optimization Project</td><td>PC-I-1.1</td><td class="data-flow">DF-5, DF-7</td></tr>
        <tr><td>PC-III(a)-1.2</td><td>Project ID</td><td>SelectField</td><td>Select Unique ProjectID</td><td>PRJ-2024-0010</td><td>PC-I-1.2</td><td class="data-flow">DF-5, DF-7</td></tr>
        <tr><td>PC-III(a)-1.6</td><td>Total Expenditure</td><td>Auto-calculated</td><td>Auto-sum of Actual + Accrued</td><td>readonly</td><td>Manual Entry</td><td class="data-flow">DF-7</td></tr>
    </tbody>
</table>

